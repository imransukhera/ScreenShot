{
  "name": "desktop-monitor",
  "version": "1.0.0",
  "description": "Background activity and screenshot monitor",
  "main": "src/main/index.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "monitor",
    "screenshot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "get-windows": "^9.3.0",
    "screenshot-desktop": "^1.15.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.desktopmonitor.app",
    "productName": "Desktop Monitor",
    "asar": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "node_modules/screenshot-desktop/**/*",
      "node_modules/date-fns/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/get-windows/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "YOUR_REPO_NAME"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Desktop Monitor Installer",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": ["sha256"],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false
    }
  }
}
